# ===================================================================
# Client Portal & Project Management (JV-CRM-005) .gitignore
# ===================================================================

# Compiled class files & build artifacts
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Log files & diagnostics
*.log
*.log.*
hs_err_pid*
replay_pid*

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath
*.sublime-project
*.sublime-workspace

# OS & Environment files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Environment variables & secrets
.env
.env.*
application-local.properties
application-secret.properties

# Uploaded project data & files (preserve directory via .gitkeep)
data/uploads/*
!data/uploads/.gitkeep
data/test-uploads/
